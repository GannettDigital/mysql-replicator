#!/bin/sh
set -e

case "$1" in
    configure)
        mkdir -p /var/lib/mysql-replicator
        chmod 0750 /var/lib/mysql-replicator
        mkdir -p /etc/mysql-replicator
        chmod 0755 /etc/mysql-replicator

        if command -v systemctl >/dev/null 2>&1; then
            systemctl daemon-reload || true
        fi
        ;;
    *)
        ;;
esac

exit 0
